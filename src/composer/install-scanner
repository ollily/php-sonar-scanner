require_once __DIR__ . DIRECTORY_SEPARATOR . 'unzip';

class InstallScanner
{

    private const bool DEBUG_INFO = true;
    private const string SONAR_URL = 'https://binaries.sonarsource.com/Distribution/sonar-scanner-cli';

    private function exitrc(mixed $msg): void
    {
        if (!empty($msg)) {
            print_r("\nexitrc: Exit with '$msg'");
        }

        die(0);
    }

    private function cleanUpFolder(string $folder): void
    {
        if (!empty($folder) && is_dir($folder)) {
            print_r("\ncleanUpFolder: Removing folder '${folder}'");
            $recDI = new RecursiveDirectoryIterator($folder, FilesystemIterator::SKIP_DOTS);
            $recII = new RecursiveIteratorIterator($recDI, RecursiveIteratorIterator::CHILD_FIRST);
            /** @var SplFileInfo $deleteItem */
            foreach ($recII as $deleteItem) {
                $deleteItem->isDir() ? rmdir($deleteItem->getRealPath()) : unlink($deleteItem->getRealPath());
            }
            rmdir($folder);
        }
    }

    private function moveAllFiles(string $srcFolder, string $targetFolder): void
    {
        if (!empty($srcFolder) && is_dir($srcFolder) && !empty($targetFolder) && is_dir($targetFolder)) {
            print_r("\nmoveAllFiles: Moving folder '${srcFolder}' to '${targetFolder}'");
            $files = scandir($srcFolder);
            if (is_array($files)) {
                foreach ($files as $file) {
                    if ($file != '.' && $file != '..') {
                        rename($srcFolder . DIRECTORY_SEPARATOR . $file, $targetFolder . DIRECTORY_SEPARATOR . $file);
                    }
                }
            }
        }
    }

    private function getOpSys(): string
    {
        $phpOs = strtolower(php_uname('s'));
        switch (true) {
            case str_contains($phpOs, 'darwin') :
                $opSys = 'macosx';
                break;
            case str_contains($phpOs, 'microsoft') :
            case str_contains($phpOs, 'cygwin') :
            case str_contains($phpOs, 'mingw') :
            case str_contains($phpOs, 'msys') :
            case str_contains($phpOs, 'windows') :
                $opSys = 'windows';
                break;
            case str_contains($phpOs, 'linux') :
                $opSys = 'linux';
                break;
            default:
                $opSys = '';
        }
        if (!empty($opSys)) {
            $opSys .= '-x64';
        }

        return $opSys;
    }

    /**
     * 
     * @param string $forceInstall
     * @param int $full
     * @param string $sonarVersion
     * @param string $rootDir
     * @param string $sonarDir
     * @return array<mixed>
     */
    private function validateInput(string $forceInstall, int $full, string $sonarVersion, string $rootDir, string $sonarDir): array
    {
        if (!empty($forceInstall)) {
            print_r("\nvalidateInput: Force reinstall");
            $forceInstall = '-f';
        }
        if (empty($sonarVersion)) {
            $this->exitrc('No sonarVersion given');
        }
        if (!empty($rootDir)) {
            // Fix relative path
            $tmpRootDir = realpath($rootDir);
            if (!is_bool($tmpRootDir)) {
                $rootDir = $tmpRootDir;
            }
        } else {
            $this->exitrc('No rootDir given');
        }
        if (!is_dir($rootDir)) {
            $this->exitrc('rootDir not existing');
        }
        if (is_dir($sonarDir)) {
            print_r("\nvalidateInput: No downloadFile is necessary");
            $full = 0;
        }
        return [$forceInstall, $full, $rootDir];
    }

    /**
     * @param string $rootDir
     * @param string $opSys
     * @param string $sonarVersion
     *
     * @return array<mixed,mixed>
     */
    private function prepareSettings(string $rootDir, string $opSys, string $sonarVersion): array
    {
        $tmpDir = $rootDir . DIRECTORY_SEPARATOR . 'target' . DIRECTORY_SEPARATOR . '.tmp';

        if (!empty($opSys)) {
            $sonarZip = "sonar-scanner-cli-$sonarVersion-$opSys.zip";
            $sonarFolderInZip = "sonar-scanner-$sonarVersion-$opSys";
        } else {
            $sonarZip = "sonar-scanner-cli-$sonarVersion.zip";
            $sonarFolderInZip = "sonar-scanner-$sonarVersion";
        }
        $dlUrl = self::SONAR_URL . DIRECTORY_SEPARATOR . $sonarZip;

        return [$tmpDir, $dlUrl, $sonarFolderInZip, $sonarZip];
    }

    private function downloadFile(string $tmpDir, string $dlUrl, string $sonarZip): void
    {
        if (file_exists($tmpDir . DIRECTORY_SEPARATOR . $sonarZip)) {
            print_r("\nAlready existing '$sonarZip'");
        } else {
            if (is_dir($tmpDir)) {
                $this->cleanUpFolder($tmpDir);
            }
            mkdir($tmpDir, recursive: true);

            chdir($tmpDir);
            print_r("\ndownloadFile: Downloading '$dlUrl'");
            // curl--insecure--parallel -o $SONAR_ZIP $dlUrl;
        }
    }

    private function provideFiles(string $tmpDir, string $libDir, string $sonarFolder, string $sonarZip): void
    {
        $zipFile = $tmpDir . DIRECTORY_SEPARATOR . $sonarZip;
        $extractFolder = $tmpDir . DIRECTORY_SEPARATOR . $sonarFolder;

        if (file_exists($zipFile)) {
            print_r("\nprovideFiles: Unzipping '$sonarZip'");
            ollily\Tools\Unzip::myFile($zipFile, $tmpDir); // @phpstan-ignore class.notFound
        } else {
            $this->exitrc('Nothing to unzip');
        }

        if (is_dir($extractFolder)) {
            print_r("\nprovideFiles: Provide scanner files");
            if (is_dir($libDir)) {
                $this->cleanUpFolder($libDir);
                sleep(3);
            }
            mkdir($libDir, recursive: true);
            $this->moveAllFiles($extractFolder, $libDir);
        } else {
            $this->exitrc('No library found');
        }
    }

    /**
     * - Downloads the scanner zip-file
     * - Unpack it and put the files in the necessary folders
     * - Reinstalls, if scanner zip-file already downloadFileed.
     *
     * <b>Notes</b>
     * - The Sonarsource server doesn't like wget, so curl must be used
     * - Could not test the script on Mac OSX
     *
     * <b>Options</b>
     * -f    If scanner zip-file already exists, forece a reinstall
     *
     * @param string $rootDir The base folder of this composer library
     * @param string $sonarInstallDir The base folder, where to install the scanner
     * @param string $sonarVersion The version of the scanner as provided by sonar-source
     * @param string $forceInstall Reinstall the scanner
     *
     * @return bool TRUE=success, else FALSE
     */
    public function installScanner(string $rootDir, string $sonarInstallDir, string $sonarVersion, string $forceInstall = ''): bool
    {
        $result = false;

        $fullProcess = 1;
        $opSys = $this->getOpSys();

        [$forceInstall, $fullProcess, $result] = $this->validateInput($forceInstall, $fullProcess, $sonarVersion, $rootDir, $sonarInstallDir);
        [$tmpDir, $dlUrl, $sonarFolderInZip, $sonarZip] = $this->prepareSettings($rootDir, $opSys, $sonarVersion);

        if (self::DEBUG_INFO) {
            print_r("\n------------------");
            print_r("\nrootDir          : '${rootDir}'");
            print_r("\nsonarInstallDir  : '${sonarInstallDir}'");
            print_r("\nsonarVersion     : '${sonarVersion}'");
            print_r("\nforceInstall     : '${forceInstall}'");
            print_r("\nfullProcess      : '${fullProcess}'");
            print_r("\nopSys            : '${opSys}'");
            print_r("\ntmpDir           : '${tmpDir}'");
            print_r("\ndlUrl            : '${dlUrl}'");
            print_r("\nsonarZip         : '${sonarZip}'");
            print_r("\nsonarFolderInZip : '${sonarFolderInZip}'");
            print_r("\n------------------");
        }
        if ($fullProcess == 1) {
            // Full process
            $this->downloadFile($tmpDir, $dlUrl, $sonarZip);
            $this->provideFiles($tmpDir, $rootDir, $sonarFolderInZip, $sonarZip);
            $result = true;
        } else {
            if ($forceInstall == '-f') {
                // Just reinstall
                $this->provideFiles($tmpDir, $rootDir, $sonarFolderInZip, $sonarZip);
            }
            $result = true;
        }
        print_r("\n");

        return $result;
    }
}
