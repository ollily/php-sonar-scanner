#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . DIRECTORY_SEPARATOR . 'Tools' . DIRECTORY_SEPARATOR . 'Unzip';

class InstallScanner
{

    private const bool DEBUG_INFO = true;
    private const string SONAR_URL = 'https://binaries.sonarsource.com/Distribution/sonar-scanner-cli';

    // Common functions

    /**
     * @param mixed $msg
     */
    private function exitrc(mixed $msg): void
    {
        if (!empty($msg)) {
            print_r("\nexitrc: Exit with '$msg'");
        }

        die(0);
    }

    /**
     * @param string $folder
     */
    private function cleanUpFolder(string $folder): void
    {
        if (!empty($folder) && is_dir($folder)) {
            print_r("\ncleanUpFolder: Cleanup folder '${folder}'");
//            $recDI = new RecursiveDirectoryIterator($folder, FilesystemIterator::SKIP_DOTS);
//            $recII = new RecursiveIteratorIterator($recDI, RecursiveIteratorIterator::CHILD_FIRST);
//            /** @var SplFileInfo $deleteItem */
//            foreach ($recII as $deleteItem) {
//                $deleteItem->isDir() ? rmdir($deleteItem->getRealPath()) : unlink($deleteItem->getRealPath());
//            }
//            rmdir($folder);
            print_r("\ncleanUpFolder: Cleanup up done");
        } else {
            print_r("\ncleanUpFolder: Nothing to clean in folder '$folder'");
        }
    }

    /**
     * @param string $dlUrl
     * @param string $targetFile
     * @return bool
     */
    private function downloadFile(string $dlUrl, string $targetFile): bool
    {
        $result = false;

        $fileHandle = fopen($targetFile, 'w+');
        if ($fileHandle) {
            $curlSession = curl_init();
            if ($curlSession) {
                curl_setopt($curlSession, CURLOPT_RETURNTRANSFER, 1);
                curl_setopt($curlSession, CURLOPT_HEADER, 0);
                curl_setopt($curlSession, CURLOPT_FOLLOWLOCATION, 1);
                curl_setopt($curlSession, CURLOPT_SSL_VERIFYPEER, 0);
                curl_setopt($curlSession, CURLOPT_URL, $dlUrl);
                curl_setopt($curlSession, CURLOPT_FILE, $fileHandle);

                $curlResult = curl_exec($curlSession);

                if (curl_errno($curlSession)) {
                    $this->exitrc('downloadFile: error:' . curl_error($curlSession));
                }
                $result = true;
                curl_close($curlSession);
            }
            fclose($fileHandle);
        }
        return $result;
    }

    /**
     * @param string $srcFolder
     * @param string $targetFolder
     */
    private function moveAllFiles(string $srcFolder, string $targetFolder): void
    {
        if (!empty($srcFolder) && is_dir($srcFolder) && !empty($targetFolder) && is_dir($targetFolder)) {
            print_r("\nmoveAllFiles: Moving folder from '$srcFolder' to '$targetFolder'");
            $files = scandir($srcFolder);
            if (is_array($files)) {
                foreach ($files as $file) {
                    if ($file != '.' && $file != '..') {
                        rename($srcFolder . DIRECTORY_SEPARATOR . $file, $targetFolder . DIRECTORY_SEPARATOR . $file);
                    }
                }
            }
            print_r("\nmoveAllFiles: Moving done");
        } else {
            print_r("\nmoveAllFiles: Nothing to move from '$srcFolder' to '$targetFolder'");
        }
    }

    /**
     * @return string
     */
    private function getOpSys(): string
    {
        $phpOs = strtolower(php_uname('s'));
        switch (true) {
            case str_contains($phpOs, 'darwin') :
                $opSys = 'macosx';
                break;
            case str_contains($phpOs, 'microsoft') :
            case str_contains($phpOs, 'cygwin') :
            case str_contains($phpOs, 'mingw') :
            case str_contains($phpOs, 'msys') :
            case str_contains($phpOs, 'windows') :
                $opSys = 'windows';
                break;
            case str_contains($phpOs, 'linux') :
                $opSys = 'linux';
                break;
            default:
                $opSys = '';
        }
        if (!empty($opSys)) {
            $opSys .= '-x64';
        }

        return $opSys;
    }

    // Process steps

    /**
     * @param string $forceInstall
     * @param int $fullProcess
     * @param string $sonarVersion
     * @param string $rootDir
     * @param string $sonarInstallDir
     * @return array<mixed>
     */
    private function validateInput(string $forceInstall, int $fullProcess, string $sonarVersion, string $rootDir, string $sonarInstallDir): array
    {
        if (!empty($forceInstall)) {
            print_r("\nvalidateInput: Force reinstall");
            $forceInstall = '-f';
        }
        if (empty($sonarVersion)) {
            $this->exitrc('No sonarVersion given');
        }
        if (!empty($rootDir)) {
            // Fix relative path
            $tmpRootDir = realpath($rootDir);
            if (!is_bool($tmpRootDir)) {
                $rootDir = $tmpRootDir;
            }
        } else {
            $this->exitrc('No rootDir given');
        }
        if (!is_dir($rootDir)) {
            $this->exitrc('rootDir not existing');
        }
        $sonarBinDir = $sonarInstallDir . DIRECTORY_SEPARATOR . 'bin';
        if (is_dir($sonarBinDir)) {
            print_r("\nvalidateInput: Sonar-scanner already exists");
            $fullProcess = 0;
        }
        return [$forceInstall, $fullProcess, $rootDir];
    }

    /**
     * @param string $rootDir
     * @param string $opSys
     * @param string $sonarVersion
     *
     * @return array<mixed,mixed>
     */
    private function prepareSettings(string $rootDir, string $opSys, string $sonarVersion): array
    {
        $tmpDir = $rootDir . DIRECTORY_SEPARATOR . 'target' . DIRECTORY_SEPARATOR . '.tmp';

        if (!empty($opSys)) {
            $sonarZip = "sonar-scanner-cli-$sonarVersion-$opSys.zip";
            $sonarFolderInZip = "sonar-scanner-$sonarVersion-$opSys";
        } else {
            $sonarZip = "sonar-scanner-cli-$sonarVersion.zip";
            $sonarFolderInZip = "sonar-scanner-$sonarVersion";
        }
        $dlUrl = self::SONAR_URL . "/$sonarZip";

        return [$tmpDir, $dlUrl, $sonarFolderInZip, $sonarZip];
    }

    private function downloadZip(string $tmpDir, string $dlUrl, string $sonarZip): void
    {
        $targetFile = $tmpDir . DIRECTORY_SEPARATOR . $sonarZip;
        if (file_exists($targetFile)) {
            print_r("\ndownloadZip: Already existing '$targetFile'");
        } else {
            if (is_dir($tmpDir)) {
                $this->cleanUpFolder($tmpDir);
            }
            if (!is_dir($tmpDir)) {
                mkdir($tmpDir, recursive: true);
            }
            print_r("\ndownloadZip: Downloading '$dlUrl' to '$targetFile'");
            $result = $this->downloadFile($dlUrl, $targetFile);
            if (!$result) {
                $this->execrc('Zipfile not downloaded');
            }
        }
    }

    /**
     * @param string $sonarInstallDir
     * @param string $tmpDir
     * @param string $sonarZip
     * @param string $sonarFolderInZip
     */
    private function provideFiles(string $sonarInstallDir, string $tmpDir, string $sonarZip, string $sonarFolderInZip): void
    {
        $zipFile = $tmpDir . DIRECTORY_SEPARATOR . $sonarZip;
        $extractFolder = $tmpDir . DIRECTORY_SEPARATOR . $sonarFolderInZip;

        if (file_exists($zipFile)) {
            print_r("\nprovideFiles: Unzipping '$zipFile'");
            \ollily\Tools\Unzip::myFile($zipFile, $tmpDir); // @phpstan-ignore class.notFound
        } else {
            $this->exitrc("Zipfile not found '$sonarZip'");
        }

        if (is_dir($extractFolder)) {
            print_r("\nprovideFiles: Provide scanner files from '$extractFolder'");
            if (is_dir($sonarInstallDir)) {
                $this->cleanUpFolder($sonarInstallDir);
                print_r("\nprovideFiles: Need a pause");
                sleep(5);
            }
            if (!is_dir($sonarInstallDir)) {
                mkdir($sonarInstallDir, recursive: true);
            }
            $this->moveAllFiles($extractFolder, $sonarInstallDir);
        } else {
            $this->exitrc("No library found in '$extractFolder'");
        }
    }

    /**
     * - Downloads the scanner zip-file
     * - Unpack it and put the files in the necessary folders
     * - Reinstalls, if scanner zip-file already downloaded.
     *
     * <b>Notes</b>
     * - The Sonarsource server doesn't like wget, so curl must be used
     * - Could not test the script on Mac OSX
     *
     * <b>Options</b>
     * -f    If scanner zip-file already exists, forece a reinstall
     *
     * @param string $rootDir The base folder of this composer library
     * @param string $sonarInstallDir The base folder, where to install the scanner
     * @param string $sonarVersion The version of the scanner as provided by sonar-source
     * @param string $forceInstall '-f'=Reinstall the scanner (Default: '')
     *
     * @return bool TRUE=success, else FALSE
     */
    public function installScanner(string $rootDir, string $sonarInstallDir, string $sonarVersion, string $forceInstall = ''): bool
    {
        $result = false;

        $fullProcess = 1;
        $opSys = $this->getOpSys();

        [$forceInstall, $fullProcess, $result] = $this->validateInput($forceInstall, $fullProcess, $sonarVersion, $rootDir, $sonarInstallDir);
        [$tmpDir, $dlUrl, $sonarFolderInZip, $sonarZip] = $this->prepareSettings($rootDir, $opSys, $sonarVersion);

        if (self::DEBUG_INFO) {
            print_r("\n------------------");
            print_r("\nrootDir          : '$rootDir'");
            print_r("\nsonarInstallDir  : '$sonarInstallDir'");
            print_r("\nsonarVersion     : '$sonarVersion'");
            print_r("\nforceInstall     : '$forceInstall'");
            print_r("\nfullProcess      : '$fullProcess'");
            print_r("\nopSys            : '$opSys'");
            print_r("\ntmpDir           : '$tmpDir'");
            print_r("\ndlUrl            : '$dlUrl'");
            print_r("\nsonarZip         : '$sonarZip'");
            print_r("\nsonarFolderInZip : '$sonarFolderInZip'");
            print_r("\n------------------");
        }
        if ($fullProcess == 1) {
            // Full process
            $this->downloadZip($tmpDir, $dlUrl, $sonarZip);
            $this->provideFiles($sonarInstallDir, $tmpDir, $sonarZip, $sonarFolderInZip);
            $result = true;
        } else {
            if ($forceInstall == '-f') {
                // Just reinstall
                $this->provideFiles($sonarInstallDir, $tmpDir, $sonarZip, $sonarFolderInZip);
            }
            $result = true;
        }
        print_r("\ninstallScanner: Terminating\n");

        return $result;
    }
}
