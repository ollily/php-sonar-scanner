$SONAR_VERSION = '8.1.0.6389';
$DS = DIRECTORY_SEPARATOR;
$SONAR_CMD = 'sonar-scanner';

$sonarArgs = $argv;
array_shift($sonarArgs);
$projectFolder = realpath(__DIR__);
$sonarInstallFolder = "${projectFolder}${DS}lib";
$sonarBinFolder = "${sonarInstallFolder}${DS}bin";
$phpInstallScanner = __DIR__ . "${DS}src${DS}composer${DS}install-scanner";

$execCmd = "${sonarBinFolder}${DS}${SONAR_CMD} " . implode(' ', $sonarArgs);

print_r("\n----------------------");
print_r("\nSONAR_VERSION        : ${SONAR_VERSION}");
print_r("\nprojectFolder        : ${projectFolder}");
print_r("\nsonarInstallFolder   : ${sonarInstallFolder}");
print_r("\nsonarBinFolder       : ${sonarBinFolder}");
print_r("\nexecCmd              : ${execCmd}");
print_r("\nphpInstallScanner    : ${phpInstallScanner}");
print_r("\n----------------------");
if (!is_dir($sonarBinFolder)) {
    require_once $phpInstallScanner;
    $obj_scanner = new InstallScanner();
    $obj_scanner->installScanner($projectFolder, $sonarInstallFolder, $SONAR_VERSION);
} else {
    print_r("Sonar-scanner is already installed: '${sonarBinFolder}'");
}

