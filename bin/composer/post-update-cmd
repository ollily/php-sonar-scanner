$SONAR_VERSION = '8.1.0.6389';
if ($argc >= 2) {
    $obj = new InstallScanner(); // @phpstan-ignore class.notFound
    if ($argc >= 3) {
        $obj->installScanner("$argv[1]", "$SONAR_VERSION", "$argv[2]"); // @phpstan-ignore class.notFound
    } else {
        $obj->installScanner("$argv[1]", "$SONAR_VERSION"); // @phpstan-ignore class.notFound
    }
}

